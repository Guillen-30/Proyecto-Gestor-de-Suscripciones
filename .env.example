# ============================================================
# CONFIGURACIÓN DE DOCKER - ARCHIVO EJEMPLO
# ============================================================
# Nota: Estas variables están en el docker-compose.yml
# Este archivo es solo para referencia

# ============================================================
# SQL SERVER
# ============================================================
ACCEPT_EULA=Y
SA_PASSWORD=382005ALH
DB_USER=sa
DB_SERVER=sqlserver
DB_NAME=SuscripcionesDB
MSSQL_TCP_PORT=1433

# ============================================================
# USER API
# ============================================================
USER_API_PORT=3001
USER_API_NODE_ENV=production

# ============================================================
# SUBSCRIPTIONS API
# ============================================================
SUBSCRIPTIONS_API_PORT=3002
SUBSCRIPTIONS_API_NODE_ENV=production

# ============================================================
# FRONTEND
# ============================================================
FRONTEND_PORT=5173
FRONTEND_NODE_ENV=production

# ============================================================
# SEGURIDAD
# ============================================================
JWT_SECRET=tu_clave_secreta_super_segura
ENCRYPTION_KEY=EstaEsUnaClaveSecretaDe32Caracteres!

# ============================================================
# RABBITMQ (para future messaging)
# ============================================================
RABBITMQ_URL=amqp://rabbitmq

# ============================================================
# NOTAS DE SEGURIDAD
# ============================================================
# En DESARROLLO: Está bien usar valores por defecto
# En PRODUCCIÓN:
#   - Cambiar SA_PASSWORD a una contraseña segura
#   - Cambiar JWT_SECRET a una clave aleatoria segura
#   - Cambiar ENCRYPTION_KEY a una clave segura
#   - Usar Docker Secrets para valores sensibles
#   - Usar variables de entorno desde un sistema seguro
